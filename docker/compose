#!/usr/bin/env bash
# Never auto-load a repository .env; credentials come from the process environment.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
mkdir -p artifacts
export COMPOSE_DISABLE_ENV_FILE=1
export HOST_UID="$(id -u)" HOST_GID="$(id -g)"
exec docker compose --env-file /dev/null -f docker-compose.yml "$@"
