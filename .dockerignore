# Allowlist: only the files the Dockerfile copies enter the build context.
# Secrets, bytecode and build output stay out even inside those paths.
**
!requirements.txt
!docker/conda-linux-64.lock
!_external/
!project/
!tests/
**/.env
**/*.env
**/.env.*
**/__pycache__
**/*.pyc
**/*.so
**/build
**/*.egg-info
